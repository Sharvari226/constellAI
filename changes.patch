+"""Selection rule and freeze_final policy-name parsing (synthetic data only; never touches stream 7)."""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+SCRIPTS = Path(__file__).resolve().parents[2] / "constellai" / "scripts"
+sys.path.insert(0, str(SCRIPTS))
+import freeze_final as ff  # noqa: E402
+import select_and_compare as sc  # noqa: E402
+
+
+def _write(root, job, name, stream, collided, fuel, sigma=25.0):
+    d = Path(root) / job
+    d.mkdir(parents=True, exist_ok=True)
+    trials = [{"index": i, "collided": bool(c), "mean_fuel_used": float(f)} for i, (c, f) in enumerate(zip(collided, fuel))]
+    (d / f"eval_{name}_stream{stream}.json").write_text(json.dumps(
+        {"policy": name, "stream": stream, "preset": "short", "noise_seed": 0,
+         "env": {"sigma_p": sigma}, "summary": {}, "trials": trials}))
+
+
+def test_choose_takes_cheapest_feasible_threshold_and_requires_pilot_run():
+    n = 100
+    ok = [0] * n
+    bad = [1] * 10 + [0] * 90  # 0.90 collision-free: infeasible at target 0.98
+    data_root = Path(pytest.importorskip("tempfile").mkdtemp())
+    for name, coll, fuel in [("heuristic_tau1", bad, 0.1), ("heuristic_tau2", ok, 0.3), ("heuristic_tau3", ok, 0.5)]:
+        _write(data_root, "s25_val_E", name, 4, coll, [fuel] * n)
+    for name in ("heuristic_tau1", "heuristic_tau2"):  # tau3 has no pilot run -> not eligible
+        _write(data_root, "s25_pilot_E", name, 6, ok, [0.3] * n)
+    data = sc.load(data_root)
+    assert sc.choose(data, 25.0, "E", 0.98) == "heuristic_tau2"
+    assert sc.choose(data, 25.0, "F600", 0.98) is None
+
+
+@pytest.mark.parametrize("name,expected", [
+    ("dist_D4", ["--distance-trigger", "4"]),
+    ("heuristic_tau1.2", ["--heuristic-tau", "1.2"]),
+    ("hcw_tau1.5", ["--hcw-tau", "1.5"]),
+    ("hcwm_k1", ["--hcw-margin-k", "1"]),
+    ("prob_analytic_p0.15_h3", ["--prob-trigger", "0.15", "--prob-horizon", "3", "--forecast-kind", "analytic"]),
+    ("prob_oracle_p0.5_h3", ["--prob-trigger", "0.5", "--prob-horizon", "3", "--forecast-kind", "oracle"]),
+])
+def test_policy_name_maps_to_evaluate_tracked_flags(name, expected):
+    assert ff.flags(name) == expected
+
+
